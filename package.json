{
  "name": "nuxt-gpt",
  "private": true,
  "type": "module",
  "author": "Landen English",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "local": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --fix . && vue-tsc --noEmit && stylelint \"**/*.{css,scss,vue}\" --fix",
    "format": "prettier --write .",
    "lint-staged": "lint-staged"
  },
  "simple-git-hooks": {
    "pre-commit": "bun lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "vue-tsc --noEmit"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@primevue/nuxt-module": "^4.2.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "marked": "^15.0.4",
    "nuxt": "^3.15.0",
    "openai": "^4.77.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "sass": "^1.83.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.4",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/stylelint-module": "^5.2.0",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@vueuse/core": "^12.2.0",
    "@vueuse/nuxt": "^12.2.0",
    "eslint": "^9.17.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "simple-git-hooks": "^2.11.1",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-scss": "^6.10.0",
    "tailwindcss-primeui": "^0.3.4",
    "typescript": "^5.7.2",
    "vue-tsc": "^2.2.0"
  }
}
